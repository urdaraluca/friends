# Copy to /srv/friends/.env and `chmod 600 .env`. Read by docker compose AND the app.

# --- compose ---
FRIENDS_TAG=latest              # pin a release, e.g. 0.1.0
BIND_ADDRESS=127.0.0.1
HOST_PORT=8000
BACKUP_HOST_DIR=/srv/friends/backups   # point at a USB drive / NAS, not the SD card

# --- app ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Public URL of the app (used for invite links), e.g. https://friends.example.com
PUBLIC_APP_URL=
# Trust X-Forwarded-* from the proxy. Safe ONLY because the port is bound to 127.0.0.1.
FORWARDED_ALLOW_IPS=*
DOCS_ENABLED=false
LOG_LEVEL=INFO
