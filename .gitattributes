# Normalize line endings: LF in the repo and in working trees (Linux containers + dart format need LF).
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.db binary

# Generated code (collapsed in GitHub diffs)
app/lib/core/api/generated/** linguist-generated=true
app/test/core/api/spike/generated/** linguist-generated=true
app/test/core/api/spike/spike_openapi.json linguist-generated=true
backend/openapi.json linguist-generated=true
backend/uv.lock linguist-generated=true
app/pubspec.lock linguist-generated=true
